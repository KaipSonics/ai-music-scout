{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ASV Scout",
  "version": "3.0.0",
  "identifier": "com.aimusicscout.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173/ai-music-scout/",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "title": "ASV Scout 3.0",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.vk.com; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
